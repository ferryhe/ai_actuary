{
  "$defs": {
    "WorkflowStep": {
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "queued",
                "running",
                "completed",
                "needs_review",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "step_kind": {
          "default": "execute",
          "enum": [
            "validate",
            "execute"
          ],
          "title": "Step Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "tool_id",
        "title"
      ],
      "title": "WorkflowStep",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "builtin": {
      "default": true,
      "title": "Builtin",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "step_count": {
      "title": "Step Count",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/WorkflowStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "title",
    "description",
    "step_count"
  ],
  "title": "Workflow",
  "type": "object"
}
