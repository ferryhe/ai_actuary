# AI Actuary local environment sample
#
# Usage: copy to .env in the repository root and fill in what you need.
#   PowerShell: Copy-Item .env.sample .env
#
# Loaded by src/reserving_workflow/cli/workbench_launcher.py:
#   load_dotenv(REPO_ROOT / ".env", override=False)
# override=False means an already-set process environment variable wins over .env.
# Restart the workbench (`python scripts/run_local_workbench.py`) after editing.
#
# Comment out variables you do not use instead of leaving them as `KEY=`:
# some SDKs (openai-python reads OPENAI_BASE_URL) treat an empty value as a
# configured-but-blank setting, which breaks requests at runtime.

# ---------------------------------------------------------------------------
# 1) Model credentials (planner / openai-agents runner)
# ---------------------------------------------------------------------------
# Used by the OpenAI planner and workflows/agent-runtimes/openai-agents (OpenAI SDK).
# Missing key => planner fails with "Missing credentials / OPENAI_API_KEY".
OPENAI_API_KEY=
# Only needed when routing through a gateway / OpenAI-compatible proxy.
# IMPORTANT: keep this line commented out when unused. An empty value
# (`OPENAI_BASE_URL=`) is read by openai-python as a blank base URL, so every
# planner call fails with "Request URL is missing an 'http://' or 'https://' protocol."
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# Used when ADK runs Google models (evaluation/adk_lanes.py picks the provider from it).
GOOGLE_API_KEY=
# Only required when a model id carries the `deepseek/` prefix (litellm routing).
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 2) Model selection
# ---------------------------------------------------------------------------
# Planner (orchestrator) model for control-plane workflow runs
# (workflows/agent-runtimes/openai-agents/config.py). Uses OPENAI_API_KEY.
# Read once at import time: restart the workbench after changing it.
# Note: the executor (Hermes worker) is deterministic and never calls a model.
AI_ACTUARY_PLANNER_MODEL=gpt-5.6-luna
# Model id for the ADK developer agent chat surface
# (developer_workflows/ai_actuary_developer/agent.py). A `deepseek/` prefix
# routes through litellm and needs DEEPSEEK_API_KEY.
# Only used when chatting in ADK Developer Web; never touches run results.
# Left commented out on purpose: the code default is gemini-2.5-flash (the value
# the test contract asserts). Uncomment only if you deliberately want another
# model here; otherwise copying this file silently overrides the documented default.
# AI_ACTUARY_ADK_MODEL=gpt-5.6-luna

# Reviewer model: AI review guidance attached to review packets
# (src/reserving_workflow/review/ai_reviewer.py). Configured independently from
# the planner, so planning and review can use different providers and models.
# Any OpenAI-compatible endpoint works (DeepSeek, gateway, local proxy, ...).
# These values are read on every call, so editing them does NOT require a
# restart (unlike the planner model above).
# DeepSeek reviewer (active):
AI_ACTUARY_REVIEW_MODEL=deepseek-flash
AI_ACTUARY_REVIEW_BASE_URL=https://api.deepseek.com/v1
# Leave AI_ACTUARY_REVIEW_API_KEY unset to reuse DEEPSEEK_API_KEY automatically
# whenever the model or base URL points at DeepSeek; otherwise set it explicitly.
# AI_ACTUARY_REVIEW_API_KEY=
# OpenAI reviewer alternative - comment out the two DeepSeek lines above and
# uncomment these two instead (empty base URL falls back to OPENAI_BASE_URL):
# AI_ACTUARY_REVIEW_MODEL=gpt-5.6-luna
# AI_ACTUARY_REVIEW_BASE_URL=
# Set to 0 to keep review packets purely deterministic (no model call).
AI_ACTUARY_AI_REVIEW_ENABLED=1
# Reasoning models spend completion tokens on thinking; DeepSeek accepts the
# max_tokens form, gpt-5 classes use max_completion_tokens. Both are handled.
AI_ACTUARY_REVIEW_MAX_TOKENS=4000
# AI_ACTUARY_REVIEW_TIMEOUT_SECONDS=60

# Narrator model: optional model-backed narrative wording on the executor side
# (src/reserving_workflow/ai_narrative.py). The executor (Hermes worker) is
# deterministic by default; when this slot is enabled the model may only rewrite
# the SUMMARY and KEY POINTS wording. Numbers stay deterministic: cited_values
# still come from the deterministic result, and any number in the generated text
# that is not present in the run evidence makes the draft fall back to the
# template. Enabled (1) by default: the executor asks the model for wording on
# every run. Set to 0 to keep the executor purely deterministic (template
# wording only) - numbers are deterministic either way.
AI_ACTUARY_NARRATIVE_ENABLED=1
# Any OpenAI-compatible provider works. Uncomment the DeepSeek pair to draft with
# DeepSeek while the planner keeps using gpt-5.6-luna.
AI_ACTUARY_NARRATIVE_MODEL=gpt-5.6-luna
# AI_ACTUARY_NARRATIVE_BASE_URL=https://api.deepseek.com/v1
# Leave AI_ACTUARY_NARRATIVE_API_KEY unset to reuse DEEPSEEK_API_KEY / OPENAI_API_KEY.
# AI_ACTUARY_NARRATIVE_API_KEY=
# AI_ACTUARY_NARRATIVE_MAX_TOKENS=1200
# AI_ACTUARY_NARRATIVE_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# 3) ADK Developer Web (default: 8001)
# ---------------------------------------------------------------------------
# Control-plane URL that developer_workflows/ai_actuary_developer/tools.py calls back into
AI_ACTUARY_CONTROL_PLANE_URL=http://127.0.0.1:8000
# ADK capability credential, at least 8 characters
AI_ACTUARY_ADK_CREDENTIAL=

# ---------------------------------------------------------------------------
# 4) Control-plane capability credentials and handshake (default: 8000)
# ---------------------------------------------------------------------------
# The three capability secrets must be supplied together or not at all:
# app.py raises "All runtime capability credentials must be configured together"
# when supplied_secret_count != 3.
# run_local_workbench.py generates random values automatically, so these are only
# required when starting uvicorn directly:
#   uvicorn reserving_workflow.api.app:create_app --factory --port 8000
# Operator Console session credential, at least 8 characters.
AI_ACTUARY_OPERATOR_CREDENTIAL=
# Bootstrap token used to approve the browser handshake, at least 8 characters.
# A fixed value also lets you approve by hand after a non-tty start:
#   python tmp/approve_handoff.py <handoff_id>
# When empty, a random token is generated per launch and only shown in the tty prompt.
AI_ACTUARY_OPERATOR_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# 5) Control-plane URLs and TTLs
# ---------------------------------------------------------------------------
AI_ACTUARY_OPERATOR_ORIGIN=http://127.0.0.1:8000
# Address the console uses to open ADK Developer Web
AI_ACTUARY_ADK_URL=http://127.0.0.1:8001
# Browser session lifetime in seconds. Range (0, 18000], default 900.
# After expiry a new handshake is required; the handoff window lasts for the
# process lifetime, so re-approval always works.
AI_ACTUARY_OPERATOR_SESSION_TTL=900
# Lifetime in seconds for exchanging the bootstrap token directly for a session.
# Range (0, 3600], default 300; the launcher overrides it to 1800.
AI_ACTUARY_OPERATOR_BOOTSTRAP_TTL=300

# ---------------------------------------------------------------------------
# 6) Smoke tests and evaluation
# ---------------------------------------------------------------------------
# Set to 1 to run the control plane on the deterministic browser_smoke_runner
# (no model credentials consumed).
AI_ACTUARY_BROWSER_SMOKE_RUNNER=
# Real-model evaluation lane: with credentials present, "local_stub" runs the
# local stub; empty means real models are called.
AI_ACTUARY_REAL_MODEL_EVAL_MODE=
